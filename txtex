# 3. CLI & Hauptablauf
# ==============================================================================

def main():
    parser = argparse.ArgumentParser(
        prog="txtex",
        formatter_class=lambda prog: SingleLineHelpFormatter(prog, max_help_position=16, width=220),
        description="txtex: Universelle, deterministische Textextraktions- und Normalisierungs-Engine.",
        add_help=False
    )
    parser.add_argument("-h", action="help", help="Hilfe anzeigen")
    parser.add_argument("files", metavar="DATEI", nargs="+", help="Pfad(e) zu Quell-Dateien (.pdf, .docx, Bilder, .pptx, .rtf, .html, .txt)")
    parser.add_argument("-o", metavar="AUSGABE", dest="output", help="Spezifischer Zieldateipfad (.txt)")
    parser.add_argument("-d", action="store_true", dest="downloads", help="Im Downloads-Ordner als .txt ablegen (Standard)")
    parser.add_argument("-s", action="store_true", dest="stdout", help="Direkte Textausgabe auf stdout ohne Speichern")
    parser.add_argument("-r", action="store_true", dest="raw", help="Rohtext ohne typografische Normalisierung ausgeben")
    parser.add_argument("-j", action="store_true", dest="json", help="Ausgabe von Metadaten als JSON (Pfad, Zeichen, Wörter, Zeilen)")



    args = parser.parse_args()

    results = []

    for file_str in args.files:
        p = Path(file_str).expanduser().resolve()
        if not p.exists():
            print(f"{RED}✗ FEHLER:{RESET} Datei nicht gefunden: {p}", file=sys.stderr)
            sys.exit(1)

        try:
            raw_text = extract_raw_text(str(p))
            if args.raw:
                final_text = raw_text
            else:
                final_text = format_standard_typography(raw_text)
        except Exception as e:
            print(f"{RED}✗ FEHLER:{RESET} Extraktion von {p.name} fehlgeschlagen: {e}", file=sys.stderr)
            sys.exit(1)

        char_count = len(final_text)
        word_count = len(final_text.split())
        line_count = len(final_text.splitlines())

        out_path = None
        if not args.stdout:
            if args.output:
                out_path = Path(args.output).expanduser().resolve()
            else:
                out_name = f"{p.stem}.txt"
                out_path = Path(DOWNLOADS_DIR) / out_name

            atomic_write_text(out_path, final_text)

        res_info = {
            "source_file": str(p),
            "output_file": str(out_path) if out_path else None,
            "characters": char_count,
            "words": word_count,
            "lines": line_count,
            "status": "success"
        }
        results.append(res_info)

        if args.stdout:
            sys.stdout.write(final_text)

    if args.json:
        print(json.dumps(results if len(results) > 1 else results[0], indent=2, ensure_ascii=False))
    elif not args.stdout:
        print(f"\n{BLUE_BOLD}=== txtex: Universelle Textextraktion & Normalisierung ==={RESET}")
        print(LINE_SEP)
        for r in results:
            print(f"{BOLD}Status:{RESET}     {GREEN}✓ ERFOLG{RESET}")
            print(f"{BOLD}Quelle:{RESET}     {r['source_file']}")
            print(f"{BOLD}Zieldatei:{RESET}  {CYAN}{r['output_file']}{RESET}")
            print(f"{BOLD}Statistik:{RESET}  {r['characters']:,} Zeichen | {r['words']:,} Wörter | {r['lines']:,} Zeilen")
            if r["output_file"]:
                print(f"{BOLD}Link:{RESET}       file://{r['output_file']}")
            print(LINE_SEP)
        print()

if __name__ == "__main__":
    main()
