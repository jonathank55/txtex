# 1. Typografie-Normalisierung (Beispiel.txt-Standard)
# ==============================================================================

def clean_heading(line: str) -> str:
    """Bereinigt eine Überschrift von Markdown-Rauten, Formatierungen und Doppelpunkten."""
    s = re.sub(r"^#{1,6}\s*", "", line.strip()).strip()
    s = re.sub(r"^\*\*|\*\*$", "", s).strip()
    return s.rstrip(":")

def is_heading(line: str) -> bool:
    """Prüft, ob eine Zeile eine isolierte Überschrift darstellt."""
    s = line.strip()
    if not s:
        return False
    if re.match(r"^#{1,6}\s+", s):
        return True
    if s.startswith(("http://", "https://", "-", "*", "•", "|", TABLE_BORDER)):
        return False
    if re.match(r"^\d+[\.\)]\s+", s):
        return False
    if "\t" in s:
        return False
    if len(s) < 90 and not s.endswith((".", "!", "?", ";", ":", '"', "”", "»", "“")):
        return True
    return False

def format_standard_typography(text: str, title: str = None) -> str:
    """
    Transformiert Fließtext oder Markdown-Inhalt deterministisch
    in die kanonische typografische Architektur von Beispiel.txt.
    """
    if not text or not text.strip():
        return ""

    lines = text.replace("\r\n", "\n").replace("\r", "\n").splitlines()
    
    # 1. Trailing URLs isolieren
    urls = []
    while lines and (not lines[-1].strip() or re.match(r"^https?://\S+$", lines[-1].strip())):
        last = lines.pop().strip()
        if last and re.match(r"^https?://\S+$", last):
            urls.insert(0, last)
            
    # 2. Expliziten Titel voranstellen, falls übergeben
    if title:
        title_clean = clean_heading(title)
        first_non_empty = next((l.strip() for l in lines if l.strip()), "")
        if clean_heading(first_non_empty) != title_clean:
            lines = [title_clean, "", ""] + lines

    sections = []
    i = 0
    n = len(lines)
    
    while i < n:
        l = lines[i]
        s = l.strip()
        if not s:
            i += 1
            continue
            
        if is_heading(l):
            hd_text = clean_heading(s)
            i += 1
            while i < n and not lines[i].strip():
                i += 1
            if i >= n:
                sections.append({"heading": hd_text, "type": "heading_only", "data": []})
                break
                
            next_l = lines[i]
            next_s = next_l.strip()
            
            if next_s.startswith(TABLE_BORDER) or (next_s.startswith("|") and next_s.endswith("|")):
                t_rows = []
                if next_s.startswith(TABLE_BORDER):
                    i += 1
                    while i < n and not lines[i].strip().startswith(TABLE_BORDER):
                        if lines[i].strip():
                            t_rows.append(lines[i].strip())
                        i += 1
                    if i < n and lines[i].strip().startswith(TABLE_BORDER):
                        i += 1
                else:
                    while i < n and lines[i].strip().startswith("|") and lines[i].strip().endswith("|"):
                        row_s = lines[i].strip()
                        if not re.match(r"^\|\s*:?-+:?\s*\|", row_s):
                            cells = [c.strip() for c in row_s.split("|")[1:-1]]
                            t_rows.append("\t\t".join(cells))
                        i += 1
                sections.append({"heading": hd_text, "type": "table", "data": t_rows})
                
            elif re.match(r"^[-*•]\s+", next_s):
                l_items = []
                while i < n and re.match(r"^[-*•]\s+", lines[i].strip()):
                    item = re.sub(r"^[-*•]\s+", "", lines[i].strip()).strip()
                    l_items.append(item)
                    i += 1
                sections.append({"heading": hd_text, "type": "list", "data": l_items})
                
            elif re.match(r"^\d+[\.\)]\s+", next_s):
                num_items = []
                while i < n and re.match(r"^\d+[\.\)]\s+", lines[i].strip()):
                    m = re.match(r"^\d+[\.\)]\s+(.*)$", lines[i].strip())
                    num_items.append(m.group(1).strip())
                    i += 1
                sections.append({"heading": hd_text, "type": "num_list", "data": num_items})
                
            else:
                paras = []
                curr_p = ""
                while i < n:
                    curr_l = lines[i]
                    curr_s = curr_l.strip()
                    if not curr_s:
                        k = i + 1
                        while k < n and not lines[k].strip():
                            k += 1
                        if k < n and is_heading(lines[k]):
                            break
                        else:
                            if curr_p:
                                paras.append(curr_p)
                                curr_p = ""
                            i += 1
                            continue
                            
                    if is_heading(curr_l):
                        break
                        
                    if curr_l.startswith("\t") or curr_l.startswith("  "):
                        if curr_p:
                            paras.append(curr_p)
                        curr_p = curr_s
                    else:
                        if not curr_p:
                            curr_p = curr_s
                        else:
                            curr_p += " " + curr_s
                    i += 1
                if curr_p:
                    paras.append(curr_p)
                sections.append({"heading": hd_text, "type": "paras", "data": paras})
                
        else:
            if s.startswith(TABLE_BORDER) or (s.startswith("|") and s.endswith("|")):
                t_rows = []
                if s.startswith(TABLE_BORDER):
                    i += 1
                    while i < n and not lines[i].strip().startswith(TABLE_BORDER):
                        if lines[i].strip():
                            t_rows.append(lines[i].strip())
                        i += 1
                    if i < n and lines[i].strip().startswith(TABLE_BORDER):
                        i += 1
                else:
                    while i < n and lines[i].strip().startswith("|") and lines[i].strip().endswith("|"):
                        row_s = lines[i].strip()
                        if not re.match(r"^\|\s*:?-+:?\s*\|", row_s):
                            cells = [c.strip() for c in row_s.split("|")[1:-1]]
                            t_rows.append("\t\t".join(cells))
                        i += 1
                sections.append({"heading": None, "type": "table", "data": t_rows})
                
            elif re.match(r"^[-*•]\s+", s):
                l_items = []
                while i < n and re.match(r"^[-*•]\s+", lines[i].strip()):
                    item = re.sub(r"^[-*•]\s+", "", lines[i].strip()).strip()
                    l_items.append(item)
                    i += 1
                sections.append({"heading": None, "type": "list", "data": l_items})
                
            elif re.match(r"^\d+[\.\)]\s+", s):
                num_items = []
                while i < n and re.match(r"^\d+[\.\)]\s+", lines[i].strip()):
                    m = re.match(r"^\d+[\.\)]\s+(.*)$", lines[i].strip())
                    num_items.append(m.group(1).strip())
                    i += 1
                sections.append({"heading": None, "type": "num_list", "data": num_items})
                
            else:
                paras = []
                curr_p = ""
                while i < n:
                    curr_l = lines[i]
                    curr_s = curr_l.strip()
                    if not curr_s:
                        k = i + 1
                        while k < n and not lines[k].strip():
                            k += 1
                        if k < n and is_heading(lines[k]):
                            break
                        else:
                            if curr_p:
                                paras.append(curr_p)
                                curr_p = ""
                            i += 1
                            continue
                    if is_heading(curr_l):
                        break
                    if curr_l.startswith("\t") or curr_l.startswith("  "):
                        if curr_p:
                            paras.append(curr_p)
                        curr_p = curr_s
                    else:
                        if not curr_p:
                            curr_p = curr_s
                        else:
                            curr_p += " " + curr_s
                    i += 1
                if curr_p:
                    paras.append(curr_p)
                sections.append({"heading": None, "type": "paras", "data": paras})

    out_blocks = []
    for sec in sections:
        hd = sec["heading"]
        stype = sec["type"]
        data = sec["data"]
        
        lines_sec = []
        if hd:
            lines_sec.append(hd)
            
        if stype == "table":
            lines_sec.append(TABLE_BORDER)
            for row in data:
                lines_sec.append(row)
            lines_sec.append(TABLE_BORDER)
            out_blocks.append("\n".join(lines_sec))
            
        elif stype == "list":
            for item in data:
                lines_sec.append(f"- {item}")
            out_blocks.append("\n".join(lines_sec))
            
        elif stype == "num_list":
            for idx, item in enumerate(data, 1):
                lines_sec.append(f"{idx}. {item}")
            out_blocks.append("\n".join(lines_sec))
            
        elif stype == "paras":
            para_lines = []
            for p_idx, p in enumerate(data):
                if p_idx == 0:
                    para_lines.append(p)
                else:
                    para_lines.append(f"\t{p}")
            if hd:
                out_blocks.append(f"{hd}\n\n" + "\n".join(para_lines))
            else:
                out_blocks.append("\n".join(para_lines))
                
        elif stype == "heading_only":
            out_blocks.append(hd)
            
    rendered = "\n\n\n".join(out_blocks).strip()
    if urls:
        rendered += "\n\n" + "\n".join(urls)
        
    return rendered + "\n"

