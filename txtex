"""
txtex
=====
Universelle, deterministische Textextraktions- und Normalisierungs-Engine.
Extrahiert Inhalte verlustfrei aus PDF, Word (.docx), Bildern (Apple Vision OCR),
PowerPoint (.pptx), RTF, HTML und Plaintext/Markdown und überführt sie in die
kanonische typografische Architektur (Beispiel.txt & GEMINI.md § 7.5).

Normierte Terminal-Ausgabe gemäß optimi-Farbnorm (GEMINI.md § 6.6).
Standardisiertes CLI-Hilfeformat gemäß txt2pdf-Norm (GEMINI.md § 6.5).
"""

import os
import sys
import re
import json
import argparse
import datetime
import shutil
from pathlib import Path

# Optimi-Farbnorm
BLUE_BOLD = "\033[1m\033[0;34m"
BLUE = "\033[0;34m"
GREEN = "\033[0;32m"
YELLOW = "\033[1;33m"
RED = "\033[0;31m"
BOLD = "\033[1m"
CYAN = "\033[0;36m"
RESET = "\033[0m"

TABLE_BORDER = "–––––––––––––––––––––––––––––––––––"
DOWNLOADS_DIR = os.path.expanduser("~/Downloads")

def get_divider(char="─", default=75) -> str:
    """Gibt eine horizontale Trennlinie dynamisch angepasst an die Terminalbreite zurück."""
    try:
        width = shutil.get_terminal_size((default, 20)).columns
        return char * max(40, width)
    except Exception:
        return char * default

def get_line_sep() -> str:
    return f"{BLUE}{get_divider()}{RESET}"

class DynamicLineSep(str):
    def __str__(self):
        return get_line_sep()
    def __repr__(self):
        return get_line_sep()
    def __add__(self, other):
        return str(self) + other
    def __radd__(self, other):
        return other + str(self)

LINE_SEP = DynamicLineSep()

class SingleLineHelpFormatter(argparse.HelpFormatter):
    """txt2pdf-konformer Einzeilen-Formatter."""
    def _split_lines(self, text, width):
        return [text]

def atomic_write_text(path: Path, text: str):
    """Schreibt Text atomar via temporäre Datei und os.replace."""
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(f"{path.suffix}.tmp.{os.getpid()}")
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(text)
    os.replace(tmp, path)

