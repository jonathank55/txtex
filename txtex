def join_hyphen_words(w1: str, w2: str) -> str:
    """Verbindet getrennte Wörter über Zeilenenden unter Berücksichtigung von Koppelungen."""
    if w1.endswith("-"):
        base = w1[:-1]
        if w2 and w2[0].isupper():
            return w1 + w2
        else:
            return base + w2
    return w1 + " " + w2

def merge_line_text(prev: str, cur: str) -> str:
    p_strip = prev.rstrip()
    c_strip = cur.lstrip()
    if p_strip.endswith("-"):
        p_words = p_strip.split()
        c_words = c_strip.split()
        if not p_words:
            return c_strip
        if not c_words:
            return p_strip
        last_w = p_words[-1]
        first_w = c_words[0]
        merged_w = join_hyphen_words(last_w, first_w)
        prefix = " ".join(p_words[:-1])
        suffix = " ".join(c_words[1:])
        return (prefix + " " if prefix else "") + merged_w + (" " if suffix else "") + suffix
    else:
        return p_strip + " " + c_strip

def is_sentence_ending(text: str) -> bool:
    t = text.strip()
    t_clean = re.sub(r'[\d\s]+$', '', t)
    return bool(re.search(r'[.!?\"”“»«\)]$', t)) or bool(re.search(r'[.!?\"”“»«\)]$', t_clean))

def extract_from_pdf(file_path: str) -> str:
    """
    Intelligente PDF-Extraktion via PyMuPDF:
    - Spaltenerkennung (1-spaltig oder 2-spaltig)
    - Präzise Silbentrennungs-Auflösung
    - Verlustfreie Absatzrekonstruktion über Spalten- und Seitengrenzen hinweg
    """
    try:
        import pymupdf
    except ImportError:
        try:
            import fitz as pymupdf
        except ImportError:
            raise RuntimeError("PyMuPDF (fitz) nicht installiert.")

    doc = pymupdf.open(file_path)
    all_lines = []

    for p_idx, page in enumerate(doc):
        dict_data = page.get_text("dict")
        page_lines = []
        for b in dict_data.get("blocks", []):
            if "lines" in b:
                for l in b["lines"]:
                    spans = l["spans"]
                    text = "".join([s["text"] for s in spans]).strip()
                    if not text:
                        continue
                    bbox = l["bbox"]
                    max_size = max([s["size"] for s in spans])
                    is_bold = any(["Bold" in s["font"] or "bold" in s["font"].lower() for s in spans])
                    font = spans[0]["font"]
                    page_lines.append({
                        "page": p_idx + 1,
                        "bbox": bbox,
                        "text": text,
                        "size": max_size,
                        "is_bold": is_bold,
                        "font": font
                    })

        # Spaltenerkennung anhand der horizontalen Zentrierung
        page_width = page.rect.width
        mid_x = page_width / 2.0
        
        # Prüfen ob Text in beiden Hälften existiert
        left_lines = [l for l in page_lines if l["bbox"][2] <= mid_x + 30]
        right_lines = [l for l in page_lines if l["bbox"][0] >= mid_x - 30]
        
        is_two_column = len(left_lines) > 5 and len(right_lines) > 5
        
        if is_two_column:
            col1 = sorted([l for l in page_lines if l["bbox"][0] < mid_x], key=lambda x: x["bbox"][1])
            col2 = sorted([l for l in page_lines if l["bbox"][0] >= mid_x], key=lambda x: x["bbox"][1])
            for l in col1: l["col"] = 1
            for l in col2: l["col"] = 2
            all_lines.extend(col1 + col2)
        else:
            sorted_lines = sorted(page_lines, key=lambda x: x["bbox"][1])
            for l in sorted_lines: l["col"] = 1
            all_lines.extend(sorted_lines)

    # Zeilen zu strukturierten Blöcken zusammensetzen
    structured_blocks = []
    curr_para = ""
    
    for i, line in enumerate(all_lines):
        t = line["text"]
        
        # Überschrift erkennen
        is_hd = (line["size"] >= 13.5 and line["is_bold"])
        if is_hd:
            if curr_para:
                structured_blocks.append(curr_para)
                curr_para = ""
            structured_blocks.append(f"# {t}")
            continue
            
        if not curr_para:
            curr_para = t
            continue
            
        prev_line = all_lines[i - 1]
        is_same_col = (line["page"] == prev_line["page"] and line["col"] == prev_line["col"])
        
        if is_same_col:
            dy = line["bbox"][1] - prev_line["bbox"][3]
            if dy > 4.0:
                if not is_sentence_ending(prev_line["text"]) and t and (t[0].islower() or not t[0].isalpha()):
                    curr_para = merge_line_text(curr_para, t)
                else:
                    structured_blocks.append(curr_para)
                    curr_para = t
            else:
                curr_para = merge_line_text(curr_para, t)
        else:
            if is_sentence_ending(prev_line["text"]):
                structured_blocks.append(curr_para)
                curr_para = t
            else:
                curr_para = merge_line_text(curr_para, t)
                
    if curr_para:
        structured_blocks.append(curr_para)
        
    return "\n\n".join(structured_blocks).strip()

def clean_drop_caps(paragraphs: list[str]) -> list[str]:
    """Bereinigt und verschmilzt Initiale (Drop Caps) aus Word-Dokumenten."""
    cleaned = []
    i = 0
    n = len(paragraphs)
    while i < n:
        text = paragraphs[i].strip()
        if not text:
            i += 1
            continue
        if len(text) <= 2 and i + 1 < n:
            next_text = paragraphs[i + 1].strip()
            if next_text and (next_text[0].islower() or not next_text[0].isalpha()):
                cleaned.append(text + next_text)
                i += 2
                continue
        cleaned.append(text)
        i += 1
    return cleaned

def extract_from_docx(file_path: str) -> str:
    """Extrahiert Text und Tabellen aus .docx mit Drop-Cap-Verschmelzung."""
    try:
        import docx
    except ImportError:
        import subprocess
        res = subprocess.run(["/usr/bin/textutil", "-convert", "txt", "-stdout", file_path], capture_output=True, text=True, timeout=60)
        if res.returncode == 0:
            return res.stdout.strip()
        raise RuntimeError("python-docx nicht verfügbar und textutil fehlgeschlagen.")

    doc = docx.Document(file_path)
    raw_paras = [p.text for p in doc.paragraphs]
    cleaned_paras = clean_drop_caps(raw_paras)
    
    # Tabellen extrahieren und tab-separiert formatieren
    table_texts = []
    for table in doc.tables:
        t_lines = [TABLE_BORDER]
        for row in table.rows:
            row_cells = [cell.text.strip().replace("\n", " ") for cell in row.cells]
            if any(row_cells):
                t_lines.append("\t\t".join(row_cells))
        t_lines.append(TABLE_BORDER)
        if len(t_lines) > 2:
            table_texts.append("\n".join(t_lines))

    parts = []
    if cleaned_paras:
        parts.append("\n\n".join(cleaned_paras))
    if table_texts:
        parts.append("\n\n" + "\n\n".join(table_texts))

    return "\n\n".join(parts).strip()

def extract_from_image(file_path: str) -> str:
    """Extrahiert Text aus Bildern/Screenshots via Apple Vision OCR auf macOS."""
    # Zuerst nach nativem swift_vision_ocr.py suchen
    scripts_dir = Path.home() / ".gemini" / "config" / "scripts"
    vision_script = scripts_dir / "swift_vision_ocr.py"
    if vision_script.exists():
        import subprocess
        res = subprocess.run([sys.executable, str(vision_script), "--image", file_path, "--full"], capture_output=True, text=True, timeout=60)
        if res.returncode == 0 and res.stdout.strip():
            return res.stdout.strip()

    # Direkter Swift-Fallback auf macOS
    if sys.platform == "darwin":
        import subprocess
        swift_code = f"""
        import Foundation
        import Vision
        import AppKit

        let url = URL(fileURLWithPath: "{file_path}")
        guard let image = NSImage(contentsOf: url),
              let cgImage = image.cgImage(forProposedRect: nil, context: nil, hints: nil) else {{
            exit(1)
        }}

        let requestHandler = VNImageRequestHandler(cgImage: cgImage, options: [:])
        let request = VNRecognizeTextRequest {{ req, err in
            guard let observations = req.results as? [VNRecognizedTextObservation], err == nil else {{ return }}
            let lines = observations.compactMap {{ $0.topCandidates(1).first?.string }}
            print(lines.joined(separator: "\\n"))
        }}
        request.recognitionLevel = .accurate
        request.usesLanguageCorrection = true
        try? requestHandler.perform([request])
        """
        res = subprocess.run(["swift", "-e", swift_code], capture_output=True, text=True, timeout=60)
        if res.returncode == 0 and res.stdout.strip():
            return res.stdout.strip()

    raise RuntimeError("Keine Bild-OCR-Engine verfügbar.")

def extract_from_rtf(file_path: str) -> str:
    """Extrahiert Text aus RTF via macOS textutil."""
    import subprocess
    res = subprocess.run(["/usr/bin/textutil", "-convert", "txt", "-stdout", file_path], capture_output=True, text=True, timeout=60)
    if res.returncode == 0:
        return res.stdout.strip()
    raise RuntimeError(f"textutil RTF-Fehler: {res.stderr}")

def extract_from_pptx(file_path: str) -> str:
    """Extrahiert Folientexte aus PPTX."""
    try:
        import pptx
        prs = pptx.Presentation(file_path)
        slides_text = []
        for idx, slide in enumerate(prs.slides, 1):
            slide_parts = []
            for shape in slide.shapes:
                if shape.has_text_frame:
                    for paragraph in shape.text_frame.paragraphs:
                        text = paragraph.text.strip()
                        if text:
                            slide_parts.append(text)
            if slide_parts:
                slides_text.append(f"Folie {idx}\n" + "\n".join(slide_parts))
        return "\n\n\n".join(slides_text).strip()
    except ImportError:
        import zipfile
        import xml.etree.ElementTree as ET
        slides_text = []
        with zipfile.ZipFile(file_path, "r") as z:
            slide_names = sorted([f for f in z.namelist() if f.startswith("ppt/slides/slide") and f.endswith(".xml")])
            for idx, sname in enumerate(slide_names, 1):
                tree = ET.fromstring(z.read(sname))
                texts = [elem.text for elem in tree.iter() if elem.tag.endswith("}t") and elem.text]
                if texts:
                    slides_text.append(f"Folie {idx}\n" + "\n".join(texts))
        return "\n\n\n".join(slides_text).strip()

def extract_from_html(file_path: str) -> str:
    """Extrahiert lesbaren Text aus HTML-Dateien."""
    from html.parser import HTMLParser
    class HTMLTextExtractor(HTMLParser):
        def __init__(self):
            super().__init__()
            self.result = []
            self.hide = False
        def handle_starttag(self, tag, attrs):
            if tag in ("script", "style", "head"):
                self.hide = True
            elif tag in ("p", "br", "div", "h1", "h2", "h3", "h4", "h5", "h6", "li", "tr"):
                self.result.append("\n")
        def handle_endtag(self, tag):
            if tag in ("script", "style", "head"):
                self.hide = False
            elif tag in ("p", "div", "h1", "h2", "h3", "h4", "h5", "h6", "li", "tr"):
                self.result.append("\n")
        def handle_data(self, data):
            if not self.hide:
                self.result.append(data)
        def get_text(self):
            raw = "".join(self.result)
            return re.sub(r"\n\s*\n", "\n\n", raw).strip()

    with open(file_path, "r", encoding="utf-8", errors="ignore") as f:
        parser = HTMLTextExtractor()
        parser.feed(f.read())
        return parser.get_text()

def extract_from_plain(file_path: str) -> str:
    """Extrahiert Plaintext / Markdown / CSV / JSON mit Kodierungsfallbacks."""
    for enc in ("utf-8", "utf-8-sig", "cp1252", "latin-1"):
        try:
            with open(file_path, "r", encoding=enc) as f:
                return f.read().strip()
        except UnicodeDecodeError:
            continue
    with open(file_path, "r", encoding="utf-8", errors="replace") as f:
        return f.read().strip()

def extract_raw_text(file_path: str) -> str:
    """Führt das Format-Routing anhand der Dateiendung durch."""
    ext = Path(file_path).suffix.lower()
    if ext in (".docx", ".doc"):
        return extract_from_docx(file_path)
    elif ext == ".pdf":
        return extract_from_pdf(file_path)
    elif ext in (".png", ".jpg", ".jpeg", ".tiff", ".bmp", ".webp"):
        return extract_from_image(file_path)
    elif ext == ".rtf":
        return extract_from_rtf(file_path)
    elif ext in (".pptx", ".ppt"):
        return extract_from_pptx(file_path)
    elif ext in (".html", ".htm", ".xhtml"):
        return extract_from_html(file_path)
    elif ext in (".txt", ".md", ".csv", ".tsv", ".json", ".xml", ".yaml", ".yml", ".typ"):
        return extract_from_plain(file_path)
    else:
        try:
            return extract_from_plain(file_path)
        except Exception:
            import subprocess
            res = subprocess.run(["/usr/bin/textutil", "-convert", "txt", "-stdout", file_path], capture_output=True, text=True, timeout=60)
            if res.returncode == 0 and res.stdout.strip():
                return res.stdout.strip()
            raise ValueError(f"Nicht unterstütztes Format: {ext}")

